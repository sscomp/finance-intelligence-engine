#!/bin/bash
# fie-backup — repository-owned PostgreSQL backup CLI (Phase 6.9B-R4).
#
# Same operator-environment contract as deploy/scripts/fie-start (R2):
#   1. load the operator-owned runtime environment file (FIE_ENV_FILE,
#      required, 0600 — secrets never in argv/Supervisor conf);
#   2. FIE_PROJECT_ROOT (canonical target-resolution root);
#   3. canonical interpreter resolution (no host fallback, fail-closed);
#   4. exec the backup module CLI:
#        python -m phase3.persistence.pg_backup backup "$@"
#
# Usage:
#   fie-backup --dest DIR [--label L] [--db-target postgres://…] [--keep-partial]
#   (--db-target defaults to the R1-resolved intelligence target from the
#    operator env file; a supplied DSN is NEVER logged and reaches
#    pg_dump only through the subprocess environment)
#
# Exit: 0 PASS · 2 classified failure (machine-readable JSON on stderr,
#       code BACKUP_*/…— see phase3/persistence/pg_backup.py) ·
#       78 configuration refusal (missing/unreadable env file etc.)
# Output: one JSON summary line on stdout (secret-free; masked forms only).

set -u

die() {
    echo "{\"error\": {\"code\": \"$1\", \"message\": \"$2\"}}" >&2
    exit 78
}

[ -n "${FIE_ENV_FILE:-}" ] || die ENV_FILE_REQUIRED \
    "FIE_ENV_FILE is not set: fie-backup refuses to invent an environment (path is not a secret)"
[ -f "${FIE_ENV_FILE}" ] || die ENV_FILE_MISSING "FIE_ENV_FILE points at a nonexistent file (path withheld)"
[ -r "${FIE_ENV_FILE}" ] || die ENV_FILE_UNREADABLE "FIE_ENV_FILE is not readable (check ownership/permissions)"

set -a
# shellcheck disable=SC1090
. "${FIE_ENV_FILE}"
set +a

[ -n "${FIE_PROJECT_ROOT:-}" ] || die PROJECT_ROOT_REQUIRED \
    "FIE_PROJECT_ROOT is not set by the env file"
[ -d "${FIE_PROJECT_ROOT}" ] || die PROJECT_ROOT_MISSING "FIE_PROJECT_ROOT does not name a directory (value withheld)"

cd "${FIE_PROJECT_ROOT}" || die PROJECT_ROOT_INACCESSIBLE "cannot enter FIE_PROJECT_ROOT (value withheld)"

# shellcheck disable=SC1091,SC2034
. scripts/fie_python_resolver.sh
fie_resolve_python || die INTERPRETER_UNRESOLVABLE \
    "no usable Python >= 3.11 interpreter resolved (source withheld)"

exec "${FIE_PYTHON_BIN}" -m phase3.persistence.pg_backup backup "$@"
# FIE HTTP runtime environment file — SCHEMA EXAMPLE (Phase 6.9B-R2).
#
# This is a TEMPLATE/SCHEMA only (Phase 6.9B-R2 §9): commit nothing but
# placeholders. The OPERATOR creates the real file on the deployment host:
#
#   install -o <runtime-user> -m 0600 /dev/null <env-file>   # then fill:
#   deploy/env/fie-runtime.env.example content copied, values substituted
#
# Contract (enforced, fail-closed):
#   * every value MUST be `export`ed — a non-export assignment is invisible
#     to the child process (Phase 6.7B wrapper lesson);
#   * the file MUST be mode 0600, owned by the runtime user
#     (deploy/scripts/fie-stage refuses anything else);
#   * no real credential ever appears in a git-tracked file — this example
#     carries placeholders only.

# ---- canonical serve-plane profile (6.9B-R1 contract) ----------------
export FIE_SERVICE_ENV={{SERVICE_ENV}}          # e.g. production | staging
export FIE_PROJECT_ROOT=/abs/path/to/fie        # explicit CWD independence root

# ---- HTTP transport ---------------------------------------------------
export FIE_HTTP_HOST=127.0.0.1
export FIE_HTTP_PORT=8790
export FIE_AUTH_MODE=token
export FIE_AUTH_TOKEN={{OPERATOR_SECRET}}       # real value on the host only

# ---- canonical DB targets (6.9B-R1 C-5; legacy aliases deprecated) ----
export FIE_DB_TARGET_RAW='postgresql://<raw_user>:<password>@127.0.0.1:5432/<raw_db>'
export FIE_DB_TARGET_INTELLIGENCE='postgresql://<user>:<password>@127.0.0.1:5432/<intelligence_db>'

# ---- runtime directories (explicit; no CWD discovery) ----------------
# export FIE_DATA_DIR=/abs/path/data            # optional: repo-derived default
# export FIE_CONFIG_DIR=/abs/path/config        # optional: repo-derived default

# ---- interpreter pin (optional; canonical resolver precedence) -------
# export FIE_PYTHON=/abs/path/venvs/fie/bin/python3
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual envs
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local artifacts (untracked in macro-report)
logs/
*.log
*.db
*.sqlite
*.sqlite3
report_offline.json

# Local config overrides (Phase 6.1 Workstream F — personal data must stay
# untracked: Telegram chat IDs, operator host paths, delivery nicknames).
# Tracked *.yaml files carry ${FIE_*} env placeholders only; copy one to a
# .local.yaml and fill in real values there.
config/publishers/telegram.local.yaml
config/reports/*.local.yaml
config/phase3/*.local.yaml

# Temp / one-off
/tmp_*.py
/tmp_*.sh
.hermes_tmp_*
phase3_smoke_test.txt
phase3_test.sh

# Backup files
*.bak
*.bak.*

# Runtime intelligence artifacts (generated by cron/pipeline runs)
metadata/reports/artifacts/

# macOS Finder noise
._*

# Python packaging artifacts (Phase 6.1: clean-env install build products)
build/
dist/

# Phase 6.8A Task H — runtime SQLite sidecars of already-ignored databases
# (*.db is ignored; *.db-wal / *.db-shm are their live companions; keeping
# them out of git never deletes the rollback artifacts themselves).
*.db-wal
*.db-shm
# The literal ":memory:" filename artifact (a misdirected SQLite target;
# real :memory: databases never touch disk, so this file is always junk).
/:memory:
# Deliberate /dev/null sentinel symlink produced by rehearsal tooling.
/metadata/reports/artifacts_will_fail

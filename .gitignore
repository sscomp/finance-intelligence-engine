# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual envs
.venv/
venv/
env/
# …except the committed env-file SCHEMA of the 6.9B-R2 deployment artifact
# (placeholders only; the real 0600 env file stays on the host)
!deploy/env/
!deploy/env/fie-runtime.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local artifacts (untracked in macro-report)
logs/
*.log
*.db
*.sqlite
*.sqlite3
report_offline.json

# Local config overrides (Phase 6.1 Workstream F — personal data must stay
# untracked: Telegram chat IDs, operator host paths, delivery nicknames).
# Tracked *.yaml files carry ${FIE_*} env placeholders only; copy one to a
# .local.yaml and fill in real values there.
config/publishers/telegram.local.yaml
config/reports/*.local.yaml
config/phase3/*.local.yaml

# Temp / one-off
/tmp_*.py
/tmp_*.sh
.hermes_tmp_*
phase3_smoke_test.txt
phase3_test.sh

# Backup files
*.bak
*.bak.*

# Runtime intelligence artifacts (generated by cron/pipeline runs)
metadata/reports/artifacts/

# macOS Finder noise
._*

# Python packaging artifacts (Phase 6.1: clean-env install build products)
build/
dist/

# Phase 6.8A Task H — runtime SQLite sidecars of already-ignored databases
# (*.db is ignored; *.db-wal / *.db-shm are their live companions; keeping
# them out of git never deletes the rollback artifacts themselves).
*.db-wal
*.db-shm
# The literal ":memory:" filename artifact (a misdirected SQLite target;
# real :memory: databases never touch disk, so this file is always junk).
/:memory:
# Deliberate /dev/null sentinel symlink produced by rehearsal tooling.
/metadata/reports/artifacts_will_fail

# --- Phase 6.8C repository productionization hygiene ---------------
# No tracked file ends in these patterns (verified before adding; tracked
# .example fixtures like examples/fie-wrapper.env.example are NOT matched).
# SQLite journal sidecar of already-ignored *.db files.
*.db-journal
# Secret-bearing file classes stay out of git by default; any tracked
# exception must be an explicit, reviewed add with synthetic placeholders
# only (e.g. *.env.example-style templates end in .example and still track).
.env
*.env
!*.env.example
*.passphrase
*.secret
*.token
# Extra tooling caches seen in cloud/CI environments.
.ruff_cache/
# Cloud-agent working dirs (never runtime state of this repository).
.claude/
.codex/

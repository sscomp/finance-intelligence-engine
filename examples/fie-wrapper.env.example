# FIE cron wrapper environment — TEMPLATE WITH SYNTHETIC PLACEHOLDERS ONLY.
#                                                                        0600
# This template documents the shape of the operator-owned wrapper env file
# that the cron wrappers (run.sh / run_weekly.sh / run_monthly.sh) source
# before the fail-closed DB-target guard (2026-10-05 6.8C productionization).
#
# RULES
#   * This file's values are PRODUCTION SECRET material. Never fill in real
#     values in this tracked template, never commit a real-bearing env file,
#     never log a DSN. The real file lives OUTSIDE the repository
#     (e.g. ~/fie-67b-upgrade/fie-wrapper-pg.env), mode 0600, referenced by:
#         export FIE_WRAPPER_ENV=/absolute/path/to/real.env
#   * DB authority: Production = PostgreSQL (postgresql:// DSNs). SQLite is
#     ROLLBACK / RECOVERY ONLY — a SQLite path in the production seed role is
#     refused in rehearsal-class environments by the DB-target guard.
#   * Every value below is a synthetic placeholder. Replace on the operator
#     environment only, inside the real (untracked, 0600) file.

# Execution-mode declaration: production cron wrappers declare production.
# (An ambient caller declaration of FIE_SERVICE_ENV keeps precedence over
# this file — 6.8A incident fix.)
export FIE_SERVICE_ENV=production

# Raw layer (db.py / raw fetch family): PostgreSQL DSN with credentials.
# PLACEHOLDER shape only — real DSN never enters git or logs.
# Phase 6.9B-R1 (C-5): CANONICAL name first — FIE_DB_TARGET_RAW. The
# legacy aliases (FIE_DB_PATH; FIE_DATABASE_URL / FIE_INTELLIGENCE_DB for
# the intelligence role) still resolve when the canonical var is unset,
# but the effective source is reported by `phase3.cli config-contract`
# (source: canonical_env vs legacy_alias) and a canonical/legacy pair
# that resolves to different targets FAILS CLOSED (6.8A B5/B7).
# NOTE: this is the raw target: FIE_DATABASE_URL must NOT be used for the
# wrapper seed target (misnamed-variable tripwire, every mode).
export FIE_DB_TARGET_RAW='postgresql://<raw_user>:<password>@127.0.0.1:5432/<raw_db>'

# Intelligence/seed target (the persistable intelligence store the guard
# resolves BEFORE any write). PostgreSQL DSN, or an accepted explicit
# rollback (SQLite) contract only when executing the documented rollback.
export FIE_DB_TARGET_INTELLIGENCE='postgresql://<fie_user>:<password>@127.0.0.1:5432/<intelligence_db>'